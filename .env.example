# Cloudflare R2 credentials for the registered-site list.
# Create the bucket first, then an API token with Object Read & Write on that bucket.
# https://developers.cloudflare.com/r2/api/tokens/

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Defaults shown.
R2_BUCKET=rss-reader-sites
R2_OBJECT_KEY=sites.db

# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
